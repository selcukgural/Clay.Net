<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Clay.Samples.Raylib</RootNamespace>
        <AssemblyName>Clay.Samples.Raylib</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Clay.Csharp\Clay.Csharp.csproj" />
      <ProjectReference Include="..\..\src\Clay.Csharp.Raylib\Clay.Csharp.Raylib.csproj" />
    </ItemGroup>

    <!-- Inter (OFL-1.1 licensed, see Assets/Fonts/Inter-OFL.txt) - raylib's built-in default font is a
         tiny 10px bitmap font that looks blocky/blurry at real UI text sizes. -->
    <ItemGroup>
      <Content Include="Assets\Fonts\Inter-Regular.ttf">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Assets\Fonts\Inter-OFL.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
